<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OS auto-backup must stay OFF: it would sweep the whole filesDir
         (docs, progress, annotations, doc-settings) into cloud/device
         backups outside the app's curated BackupZip/Restore contract
         (audit EPUB-008) — e.g. doc-settings.json is mobile-only and is
         deliberately excluded from the schema-1 backup ZIP. The app ships
         its own explicit backup UI (Settings → Backup). -->
    <application
        android:name=".FolioApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.FolioMobile">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FolioMobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open imported docs from other apps (file managers). Only types
                 the pipeline actually accepts are listed (audit EPUB-001):
                 octet-stream is refused by ImportDispatch, so advertising it
                 launched users into the "Unsupported format" dead-end.
                 Not a web/App Link intent-filter — there is no URL host, the
                 VIEW filter receives local files by MIME type only. -->
            <intent-filter
                tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".reader.ReaderActivity"
            android:theme="@style/Theme.FolioMobile"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:theme="@style/Theme.FolioMobile"
            android:exported="false" />
        <activity
            android:name=".NotesActivity"
            android:theme="@style/Theme.FolioMobile"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>

</manifest>
